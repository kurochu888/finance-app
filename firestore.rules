rules_version = '2';

// 只有屋主本人(這個 uid)讀寫得到,其他人(含別的 Google 帳號、未登入者)一律拒絕。
// 換帳號登入的話,要把下面的 uid 換成新帳號的(Firebase 主控台 → Authentication → 使用者)。
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null
                         && request.auth.uid == uid
                         && uid == 'CEWIrPRu9mXNRcSwrmjIjf1joaB2';
    }
  }
}
